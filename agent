#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

if [[ -f .env ]]; then
  set -a
  source .env
  set +a
fi
if [[ -z "${JAVA_HOME:-}" && -x /usr/libexec/java_home ]]; then
  export JAVA_HOME
  JAVA_HOME=$(/usr/libexec/java_home -v 21)
fi
if [[ ! -x build/install/coding-agent/bin/coding-agent ]]; then
  ./gradlew --no-daemon installDist
fi
exec build/install/coding-agent/bin/coding-agent "$@"
